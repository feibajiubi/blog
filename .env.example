# ============================================
# 环境变量模板（复制为 .env 并填入真实值）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ⚠️ .env 已被 .gitignore 排除，绝不要提交到 git
# ============================================

# ----- DeepSeek API Key（鲸鱼娘 AI 对话，必填才能用真 AI）-----
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-你的key

# ----- Django SECRET_KEY（必填，缺失会启动报错）-----
# 生成方法：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=随机生成的50位字符串

# ----- MySQL 数据库 -----
DB_NAME=blog
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_HOST=localhost
DB_PORT=3306

# ----- 部署环境（本地开发默认值如下）-----
# DEBUG：生产必须设为 False
# DJANGO_DEBUG=False
# 允许访问的域名，逗号分隔（生产必填）
# DJANGO_ALLOWED_HOSTS=www.example.com,example.com
